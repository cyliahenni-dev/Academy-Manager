{
  "name": "academy-manager",
  "version": "1.0.0",
  "description": "Academy management system",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon server.js",
    "postinstall": "electron-rebuild",
    "dist": "electron-builder --win nsis"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.academy.manager",
    "productName": "Academy Manager",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "preload.js",
      "server.js",
      "db.js",
      "routes/**/*",
      "public/**/*",
      "node_modules/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Academy Manager",
      "artifactName": "Academy-Manager-Setup-${version}.exe"
    }
  }
}